---
// Zorro Funding — modern landing + full survey/dossier funnel, built on the
// doneviral design system (Astro + Tailwind v4 + GSAP scroll-reveal) for the
// marketing surface, mirroring zorro-lead-engine's proven engine (Phase 1/2
// survey, GAS write, multi-pass dossier generation, PDF) for the functional
// core. See agents.md for the port notes and what's shared vs. duplicated.
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Marquee from "../components/Marquee.astro";
import Section from "../components/Section.astro";
import SecHeader from "../components/SecHeader.astro";
import Button from "../components/Button.astro";
import Tag from "../components/Tag.astro";
import Sticker from "../components/Sticker.astro";
import Card from "../components/Card.astro";
import Reveal from "../components/Reveal.astro";

const marqueeItems = [
  "One sketch",
  "One prompt",
  "Sixteen real steps",
  "Zero designers hired",
  "Built by Exponent Labs",
];
---

<BaseLayout
  title="Founder Sketch to Finished Brand — Exponent Labs × Umami Salt"
  description="A real before/after AI workflow: WhatsApp sketch to ChatGPT brand kit to packaging to Higgsfield-animated trailer."
>
  <Nav />

  <main class="zf-home">
    <!-- HERO -->
    <header class="hero-header">
      <div class="wrap hero">
        <Tag class="reveal">AI Clinic · Ticket 500 · Newport Beach</Tag>
        <h1 class="reveal">
          From Ideation to <span class="ind">$5,000.00</span>
        </h1>
        <p class="sub reveal">
          How we went from sketch to funded in a single afternoon.
        </p>
        <div class="hero-cta reveal">
          <Button href="#trailer">Watch the Trailer</Button>
          <Button variant="alt" href="#sketch">See how it happened</Button>
        </div>
        <div class="badges reveal">
          <Sticker variant="y">Umami Salt</Sticker>
          <Sticker>Built by Exponent Labs</Sticker>
          <Sticker variant="i">Live Case Study</Sticker>
        </div>
      </div>

      <Marquee class="hero-marquee" items={marqueeItems} />
    </header>

    <!-- PHASE 1 — THE SKETCH -->
    <Section id="sketch">
      <SecHeader label="Phase 1" title="It all started when Abinashi sent me this sketch." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/01-umamisalt-whatsapp-sketch.png" alt="Abinashi's original WhatsApp sketch" />
      </Reveal>
    </Section>

    <!-- PHASE 2 — THE PROMPT -->
    <Section id="prompt">
      <SecHeader label="Phase 2" title="I took that sketch into ChatGPT and added a simple prompt." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/02-umamisalt-chatGPT-prompt-to-brandkit-image-and-prompt-alone.png" alt="The ChatGPT prompt" />
      </Reveal>
    </Section>

    <!-- PHASE 3 — THE RESULT -->
    <Section id="brandkit">
      <SecHeader label="Phase 3" title="And this is what I got." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/03-umamisalt-chatGPT-prompt-to-brandkit-image-and-prompt-with-image-result.png" alt="Prompt plus sketch, and the brand kit result" />
      </Reveal>
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/03point1-umamisalt-initial-brandkit-image.jpeg" alt="The initial brand kit image, full size" />
      </Reveal>
    </Section>

    <!-- PHASE 4 — SHARING IT -->
    <Section id="sharing">
      <SecHeader label="Phase 4" title="So I sent it to Abinashi and Brian in the WhatsApp group chat." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/03point2-umamisalt-whatsapp-sketch-to-brandkit-send.png" alt="Sending the brand kit to the group chat" />
      </Reveal>
    </Section>

    <!-- PHASE 5 — THE PACKAGING ASK -->
    <Section id="packaging">
      <SecHeader label="Phase 5" title="They said that's good — but Abinashi wanted the packaging to look like this." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/04-umamisalt-package-design-pattern-to-emulate.webp" alt="The packaging reference Abinashi wanted to emulate" />
      </Reveal>
    </Section>

    <!-- PHASE 6 — NEW PACKAGING -->
    <Section id="packaging-result">
      <SecHeader label="Phase 6" title="So we took that reference back into ChatGPT with a simple prompt, and got this." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/04point2-umamisalt-chatGPT-brandkit-and-samplepackaging-to-brand-packaging.png" alt="Brand kit plus the packaging reference, prompted into new packaging" />
      </Reveal>
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/04point5-umamisalt-brandkit-packaging-large.jpeg" alt="The finished packaging, full size" />
      </Reveal>
    </Section>

    <!-- PHASE 7 — FEEDBACK -->
    <Section id="feedback">
      <SecHeader label="Phase 7" title="We sent it to the group and started getting immediate feedback from Abinashi and team." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/05-umamisalt-whatsapp-feedback-on-brandkit.png" alt="Real-time feedback from the group chat" />
      </Reveal>
    </Section>

    <!-- PHASE 8 — CHARACTER SHEET -->
    <Section id="character">
      <SecHeader label="Phase 8" title="This is where we started having fun. We turned the character into a full-blown character sheet with karate animations." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/06-umamisalt-chatGPT-character-sheet-for-higgsfield-animation.png" alt="Prompting the full character sheet" />
      </Reveal>
    </Section>

    <!-- PHASE 9 — CHARACTER RESULT -->
    <Section id="character-result">
      <SecHeader label="Phase 9" title="And ended up with this." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/07-umamisalt-brandkit-character-sheet-martialarts.jpeg" alt="The finished character sheet, full size" />
      </Reveal>
    </Section>

    <!-- PHASE 10 — INTO HIGGSFIELD -->
    <Section id="higgsfield">
      <SecHeader label="Phase 10" title="Then we took the character into Higgsfield." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/08-umamsalt-higgsfield-initialimage.png" alt="The character loaded into Higgsfield" />
      </Reveal>
    </Section>

    <!-- PHASE 11 — TRAILER PROMPT -->
    <Section id="trailer-prompt">
      <SecHeader label="Phase 11" title="And then we got a prompt for the trailer from ChatGPT." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/09-umamisalt-chatGPT-charactersheet-to-higgsfield-seedance-prompt.png" alt="ChatGPT writing the Seedance motion prompt" />
      </Reveal>
    </Section>

    <!-- PHASE 12 — MOTION RESULT -->
    <Section id="motion">
      <SecHeader label="Phase 12" title="We took that prompt from ChatGPT into Higgsfield, and got this." />
      <Reveal class="phase-shot">
        <img class="shot-lg" src="/assets/09point5-umamisalt-higgsfield-video-and-prompt.png" alt="Higgsfield generating the motion" />
      </Reveal>
    </Section>

    <!-- PHASE 13 — THE FINAL TRAILER -->
    <Section id="trailer">
      <SecHeader label="Phase 13" title="And here's the final trailer." />
      <Reveal class="phase-shot">
        <div class="video-frame video-frame-lg">
          <video controls playsinline>
            <source src="/assets/umamisalt-higgsfield-animation-final-output.mp4" type="video/mp4" />
          </video>
        </div>
      </Reveal>
    </Section>

    <!-- PHASE 14 — THE INVESTMENT -->
    <Section id="investment">
      <SecHeader label="Phase 14" title="Someone else was watching the whole time." />
      <Reveal class="prose-block">
        <p class="story-lede">B. Ahuja, MD was in the same group chat as Abinashi — not pitched, not demoed, just there, watching the sketch turn into a brand kit, the brand kit turn into packaging, the packaging turn into a character that could move.</p>
        <p>He watched all of it happen in real time. Then he decided to invest $5,000 — becoming Umami Salt's first investor.</p>
      </Reveal>
    </Section>

    <!-- MEET THE FOUNDER — ABINASHI KHALSA -->
    <Section id="founder">
      <SecHeader label="Meet the Founder" title="Abinashi Khalsa" lead="Founder & CEO, Umami Salt (working name)" />
      <Reveal class="prose-block">
        <p class="story-lede">Nearly twenty years building startups, the last thirteen exclusively in manufacturing. Three companies founded since 2007, one consistent shape: take a physical product into a new or difficult category, build the financial and operational machinery around it from nothing, and run it with discipline until it scales. The finance leader who also knows the factory floor — BOM planning, supply chain, cost analysis at the discrete-process level — and the operator who brings order to early-stage chaos.</p>

        <h3 class="font-display">Track record</h3>
        <p><strong>Founding CFO of a California cannabis manufacturer, launched at legalization.</strong> Built the company's entire financial infrastructure from the ground up in a brand-new regulated consumer category: accounting systems, financial controls, ERP, and a weekly cash-planning discipline that gave leadership a day-to-day read on cash and true COGS. Grew revenue from $1M in 2019 to $8M trailing-twelve-months by 2024, managed the Series A round alongside the CEO, and led the acquisition and integration of a smaller competitor. Six years navigating compliance, contract negotiation, and board reporting in one of the most heavily regulated consumer categories in the country — the closest analog that exists to launching a food CPG brand.</p>
        <p><strong>Interim CFO of a natural-foods manufacturer.</strong> Delivered the financial planning and analysis that took the company into Costco — selling into more than 400 warehouses.</p>
        <p><strong>Business operations and manufacturing director at a biomass-energy equipment manufacturer.</strong> Ran finance in the absence of a CFO while also directing production: a 1,500-part bill of materials, vendor qualification, international logistics, and a cost-reduction program that cut total product cost 20%. Separately built $30M in grant proposal budgets and managed $5M in awarded state energy grants.</p>
        <p><strong>Tapped as CFO of a U.S. chemical-manufacturing startup</strong>, stepping into the seat when its first institutional raise lands — already owning the financial modeling, unit economics, and capital strategy behind that raise as its finance consultant.</p>

        <h3 class="font-display">Why salt</h3>
        <p>This is not a whim. Abinashi began developing Umami Salt in 2023 — label design, packaging engineering, and vendor quotes predate the current launch push by three years. The founding team formed around a product that already existed: a co-founder's locked formulation, a secured domain, and Abinashi as the operator who takes it from recipe to shelf.</p>

        <h3 class="font-display">What that means for an investor</h3>
        <p>The premise of this venture is that a great product fails without operational and capital discipline — and that discipline is precisely what Abinashi has spent his career supplying. Company formation, compliance-first go-to-market, sourcing and packaging economics, staged fundraising that protects the cap table, and cash management measured weekly, not quarterly. He is the majority founder, he intends to keep steering, and he prices everything on the base case.</p>
      </Reveal>
    </Section>

    <!-- ROTI — RETURN ON TOKEN INVESTMENT -->
    <section class="band" id="roti">
      <div class="wrap">
        <SecHeader
          class="band-head"
          label="ROTI"
          title="Return on Token Investment"
          lead="What this actually cost, in real tools — no hidden spend."
        />
        <Reveal stagger class="stats">
          <div class="stat"><div class="stat-num">$0</div><div class="stat-label">ChatGPT — image creation + Higgsfield prompts</div></div>
          <div class="stat"><div class="stat-num">$0</div><div class="stat-label">WhatsApp — coordination, feedback, sharing</div></div>
          <div class="stat"><div class="stat-num">$7</div><div class="stat-label">Higgsfield — premium cinematic quality</div></div>
        </Reveal>
        <p class="band-note mono">Total spend: $7. Everything else on this page, free.</p>
      </div>
    </section>

    <!-- BENCHMARK BAND -->
    <section class="band">
      <div class="wrap">
        <SecHeader
          class="band-head"
          label="The mechanism, not a promise"
          title="What actually happened, end to end"
        />
        <Reveal stagger class="stats">
          <div class="stat"><div class="stat-num">1</div><div class="stat-label">Founder sketch</div></div>
          <div class="stat"><div class="stat-num">16</div><div class="stat-label">Real steps, no theater</div></div>
          <div class="stat"><div class="stat-num">3</div><div class="stat-label">Tools: ChatGPT, Higgsfield, WhatsApp</div></div>
          <div class="stat"><div class="stat-num">0</div><div class="stat-label">Designers hired</div></div>
        </Reveal>
        <p class="band-note mono">Every image on this page is a real screenshot from the actual workflow. Nothing staged for tonight.</p>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final" id="start">
      <div class="wrap">
        <h2 class="reveal">This is what an AI workflow looks like when the founder is real and the stakes are real.</h2>
        <p class="reveal">Sketch → Brand Kit → Packaging → Character &amp; Motion → Trailer. Built by Exponent Labs — the same syndicate model behind Zorro Funding and the rest of tonight's case studies.</p>
        <form id="email-capture-form" class="capture-form reveal">
          <label for="capture-email" class="capture-label">I wanna learn how to do this.</label>
          <div class="capture-row">
            <input id="capture-email" type="email" name="email" placeholder="you@email.com" required autocomplete="email" class="capture-input" />
            <Button type="submit" class="capture-submit">Count me in</Button>
          </div>
          <p id="capture-status" class="capture-status" role="status"></p>
        </form>
      </div>
    </section>
  </main>

  <Footer />

</BaseLayout>

<script>
  import { initRevealGroups, initScrollReveal, initCounters } from "../lib/motion";
  initRevealGroups();
  initScrollReveal();
  initCounters();

  // Email capture -> Google Apps Script -> Google Sheet.
  // Replace with the real /exec URL after deploying google-apps-script/Code.gs.
  const GAS_ENDPOINT = "https://script.google.com/macros/s/AKfycbzHtpEPHPRLj6y74QhDA37IW5dFQ_nW0UT6NKPmiBJyc5BX21w1WFuEX7xugG0mBnciqg/exec";

  const form = document.getElementById("email-capture-form") as HTMLFormElement | null;
  const status = document.getElementById("capture-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById("capture-email") as HTMLInputElement | null;
    const email = emailInput?.value.trim() ?? "";
    if (!email) return;

    const submitBtn = form.querySelector<HTMLButtonElement>(".capture-submit");
    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = "Sending...";

    try {
      // Apps Script Web Apps don't return CORS headers, so the response body
      // isn't readable from the browser. no-cors still delivers the POST.
      await fetch(GAS_ENDPOINT, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify({ email, source: window.location.href }),
      });
      if (status) status.textContent = "You're in — we'll be in touch.";
      form.reset();
    } catch {
      if (status) status.textContent = "Something went wrong — try again in a sec.";
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .zf-home :global(.font-display) { font-family: var(--font-display); }

  /* ---- Hero ---- */
  .hero-header { background: var(--color-paper); padding-top: 72px; }
  .hero { text-align: center; max-width: 880px; padding-bottom: 56px; }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 6.6vw, 5.4rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 24px 0 22px;
  }
  .hero .ind { color: var(--color-indigo); }
  .hero .ul { background: linear-gradient(transparent 62%, var(--color-yellow) 62%); }
  .hero .sub {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin: 0 auto 28px;
    line-height: 1.55;
  }
  .hero-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 20px; }
  .hero-note { font-size: 0.92rem; color: var(--color-ink-soft); margin-bottom: 26px; }
  .badges { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  /* ---- Problem split panels ---- */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 12px; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
  .panel { border: 2px solid var(--color-ink); border-radius: var(--radius-card); padding: 30px; box-shadow: var(--shadow); }
  .panel.bright { background: var(--color-paper-2); }
  .panel.dark { background: var(--color-ink); color: var(--color-paper); }
  .panel h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; margin-bottom: 18px; }
  .panel.dark h3 small { color: var(--color-yellow); font-style: normal; }
  .panel ul { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .panel li { display: flex; gap: 10px; align-items: flex-start; line-height: 1.5; }
  .panel .mk { font-weight: 900; flex-shrink: 0; }
  .panel.bright .mk { color: #C0392B; }
  .panel.dark .mk { color: var(--color-yellow); }

  /* ---- How it works cards ---- */
  .rows { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 12px; }
  @media (max-width: 900px) { .rows { grid-template-columns: 1fr; } }
  .rows :global(.dv-card h4) { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; margin-bottom: 10px; }
  .rows :global(.dv-card p) { color: var(--color-ink-soft); font-size: 0.96rem; line-height: 1.55; }

  /* ---- Benchmark band ---- */
  .band { background: var(--color-indigo); color: #fff; padding: 72px 0; }
  .band :global(.dv-secheader__label) { background: var(--color-yellow); color: var(--color-ink); }
  .band :global(.dv-secheader__title) { color: #fff; }
  .band :global(.dv-secheader__lead) { color: rgba(255, 255, 255, 0.85); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; } }
  .stat-num { font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4vw, 2.8rem); }
  .stat-label { font-size: 0.85rem; color: rgba(255, 255, 255, 0.8); margin-top: 6px; }
  .band-note { color: rgba(255, 255, 255, 0.65); margin-top: 32px; }

  /* ---- Final CTA ---- */
  .final { background: var(--color-ink); color: var(--color-paper); padding: 100px 0; text-align: center; }
  .final h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.2rem, 5.6vw, 4.4rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .final p { color: rgba(247, 244, 239, 0.75); max-width: 56ch; margin: 0 auto 30px; }

  /* ---- Case-study shots (this page only, same brand tokens as the rest) ---- */
  .shot-single { margin-top: 28px; max-width: 640px; }
  .shot-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 28px; }
  @media (max-width: 760px) { .shot-grid { grid-template-columns: 1fr; } }
  .shot-item { display: flex; flex-direction: column; }
  .shot {
    width: 100%;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow);
    background: var(--color-paper-2);
    display: block;
  }
  .video-frame {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow);
    background: var(--color-ink);
    overflow: hidden;
  }
  .video-frame video { width: 100%; display: block; }
  .cap {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    margin-top: 10px;
  }

  /* ---- Large phase shots — stage-visible, near full width ---- */
  .phase-shot { margin-top: 28px; }
  .phase-shot + .phase-shot { margin-top: 40px; }
  .shot-lg {
    width: 100%;
    max-width: 1080px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    background: var(--color-paper-2);
    display: block;
  }
  .video-frame-lg { max-width: 1080px; }
  .video-frame-lg video { width: 100%; display: block; }

  /* ---- Email capture (final CTA) ---- */
  .capture-form { margin-top: 40px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .capture-label { display: block; font-weight: 700; margin-bottom: 14px; color: var(--color-paper); }
  .capture-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .capture-input {
    flex: 1 1 240px;
    padding: 13px 16px;
    font-size: 0.95rem;
    font-family: var(--font-body);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-btn);
    background: var(--color-paper-2);
    color: var(--color-ink);
    outline: none;
  }
  .capture-input:focus { outline: 3px solid var(--color-indigo); outline-offset: 1px; }
  .capture-submit { flex-shrink: 0; }
  .capture-status { margin-top: 14px; font-size: 0.85rem; color: rgba(247, 244, 239, 0.75); min-height: 1.2em; }

  /* ---- Prose blocks: Investment beat + Founder bio ---- */
  .prose-block { max-width: 720px; margin-top: 28px; }
  .prose-block .story-lede {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .prose-block p { font-size: 1rem; line-height: 1.75; color: var(--color-ink-soft); margin-bottom: 18px; }
  .prose-block p strong { color: var(--color-ink); }
  .prose-block h3 {
    font-weight: 800;
    font-size: 1.3rem;
    margin: 36px 0 14px;
    color: var(--color-ink);
  }
  .prose-block h3:first-child { margin-top: 0; }
</style>


