---
/**
 * SecHeader.astro — section header block: sec-label (ink chip) + sec-title
 * (display) + sec-lead (ink-soft). Provide `label`, `title`, `lead` via props,
 * or override with named slots. The whole block is a `.reveal` target by default.
 */
interface Props {
  label?: string;
  title?: string;
  lead?: string;
  reveal?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { label, title, lead, reveal = true, class: className = "", ...rest } = Astro.props;

const hasLead = lead || Astro.slots.has("lead");
const hasTitle = title || Astro.slots.has("title");
const hasLabel = label || Astro.slots.has("label");
---

<div class={["dv-secheader", reveal && "reveal", className].filter(Boolean).join(" ")} {...rest}>
  {hasLabel && (
    <span class="dv-secheader__label">
      <slot name="label">{label}</slot>
    </span>
  )}
  {hasTitle && (
    <h2 class="dv-secheader__title font-display">
      <slot name="title">{title}</slot>
    </h2>
  )}
  {hasLead && (
    <p class="dv-secheader__lead">
      <slot name="lead">{lead}</slot>
    </p>
  )}
  <slot />
</div>

<style>
  .dv-secheader__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 5px 11px;
    border-radius: 6px;
    margin-bottom: 20px;
  }
  .dv-secheader__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 4vw, 2.9rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  .dv-secheader__lead {
    color: var(--color-ink-soft);
    max-width: 56ch;
    margin-top: 18px;
    font-size: 1.1rem;
  }
</style>
